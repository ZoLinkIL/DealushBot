# Copy this file to .env and fill in. Never share .env with anyone.

# From @BotFather in Telegram (required)
TELEGRAM_TOKEN=
BOT_NAME=דילוש
# Your Telegram numeric user id (get it from @userinfobot) - unlocks /stats
ADMIN_IDS=

# --- Screenshot reading: fill ONE of the two (without it the bot asks for a link/text) ---
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude: key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Comparison rules ---
CHEAPER_THRESHOLD=0.05
WATCH_INTERVAL_HOURS=6

# --- Affiliate (fill in later, after the accounts are approved) ---
TP_MARKER=
# Redirect format from the Travelpayouts link generator. Use {marker} {program} {url}
TP_REDIRECT_TEMPLATE=
TP_PROGRAM_AGODA=
TP_PROGRAM_TRIP=
TP_PROGRAM_BOOKING=
TP_PROGRAM_EXPEDIA=
AGODA_CID=
# Trip.com direct affiliate (approved) - these are public link IDs, not secrets
TRIP_ALLIANCE_ID=11189452
TRIP_SID=334834760
BOOKING_AID=
